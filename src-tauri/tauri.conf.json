{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerBond",
  "version": "1.3.16",
  "identifier": "com.serverbond.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ServerBond · Windows Laravel üretimi",
        "visible": false,
        "width": 1360,
        "height": 950,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ServerBond",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Windows üzerinde Laravel üretim ortamı",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "minimumWebview2Version": "109.0.1518.0",
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NjU2M0EwOEE3Qzc4QjMKUldTemVIeUtvR05sT0hYWm9SV3pOVzM5eXZvN3JVY2lvSXJXZjI2U0RTMEJEZmJCaXU2eVNiQWUK",
      "endpoints": [
        "https://github.com/beyazitkolemen/serverbond-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
