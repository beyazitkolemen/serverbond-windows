{
  "name": "serverbond",
  "private": true,
  "version": "1.3.20",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:unsigned": "tauri build --config .github/tauri-unsigned.json",
    "test:core": "cargo test -p serverbond-core",
    "test:rust:parallel": "cargo nextest run --workspace --locked -j 8 --status-level fail --final-status-level fail",
    "test:mcp": "cargo build -p serverbond-core --bin serverbond && node scripts/ai/test-mcp.mjs",
    "test:ai": "bash scripts/ai/test.sh",
    "test:integration": "cargo run -p serverbond-core --bin serverbond -- smoke",
    "check": "npm run build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
